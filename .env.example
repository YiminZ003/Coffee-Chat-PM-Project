# For working offline demo mode, leave the Supabase fields blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set false in a real release to disable fictional local browser demo.
NEXT_PUBLIC_ENABLE_DEMO=true
# Optional server-side OpenAI-compatible model. NEVER use NEXT_PUBLIC_ for secrets.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
